[Unit]
Description=Impala Family signer API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=impala-signer
Group=impala-signer
WorkingDirectory=/opt/impala-fam/signer
EnvironmentFile=/etc/impala-fam-signer.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node /opt/impala-fam/signer/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/impala-fam-signer

[Install]
WantedBy=multi-user.target
